{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "failed"
      ]
    },
    "error": {
      "type": "string",
      "maxLength": 500
    },
    "runs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "ok",
              "runtime_error",
              "time_limit",
              "memory_limit",
              "output_limit",
              "compile_error",
              "compile_time_limit"
            ]
          },
          "timeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "report": {
            "type": "object",
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "firstMismatch": {
                "type": "object",
                "properties": {
                  "call": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "required": [
                  "call",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "passed"
            ],
            "additionalProperties": false
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "failure": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e]{1,64}$"
              },
              "message": {
                "type": "string",
                "pattern": "^[\\x20-\\x7e]{1,200}$"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "name",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "verdict",
          "timeMs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "status",
    "runs"
  ],
  "additionalProperties": false
}
